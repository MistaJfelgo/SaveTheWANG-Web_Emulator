+#ifdef __EMSCRIPTEN__
+#include <emscripten.h>
+#include "formats/flopimg.h"
+#include <cstdio>
+
+namespace {
+std::string wang_web_error;
+}
+
+extern "C" {
+EMSCRIPTEN_KEEPALIVE int wang_ready()
+{
+    return running_machine::emscripten_get_running_machine() != nullptr;
+}
+
+EMSCRIPTEN_KEEPALIVE double wang_time()
+{
+    auto *machine = running_machine::emscripten_get_running_machine();
+    return machine ? machine->time().as_double() : 0.0;
+}
+
+EMSCRIPTEN_KEEPALIVE const char *wang_text()
+{
+    static std::string text;
+    text.clear();
+    auto *machine = running_machine::emscripten_get_running_machine();
+    auto *share = machine ? machine->root_device().memshare(":slot2:mvc:video_ram") : nullptr;
+    if (!share) return text.c_str();
+    const auto *words = reinterpret_cast<const uint16_t *>(share->ptr());
+    for (int i = 0; i < 2048; ++i) {
+        const unsigned ch = words[i] >> 8;
+        text += ch >= 32 && ch < 127 ? char(ch) : ' ';
+        if (i % 80 == 79) text += '\n';
+    }
+    return text.c_str();
+}
+
+EMSCRIPTEN_KEEPALIVE const char *wang_last_error()
+{
+    return wang_web_error.c_str();
+}
+
+EMSCRIPTEN_KEEPALIVE int wang_key(int row, int mask, int down)
+{
+    auto *machine = running_machine::emscripten_get_running_machine();
+    if (!machine || row < 0 || row > 15) return 0;
+    auto *port = machine->root_device().ioport(util::string_format(":wangpckb:Y%d", row).c_str());
+    auto *field = port ? port->field(mask) : nullptr;
+    if (!field) return 0;
+    field->set_value(down ? 1 : 0);
+    return 1;
+}
+
+EMSCRIPTEN_KEEPALIVE int wang_floppy(int drive, const char *path)
+{
+    auto *machine = running_machine::emscripten_get_running_machine();
+    if (!machine || drive < 0 || drive > 1) return 0;
+    auto *image = machine->root_device().subdevice<floppy_image_device>(
+        drive ? "upd765:1:525dd" : "upd765:0:525dd");
+    if (!image) return 0;
+    wang_web_error.clear();
+    if (!path || !*path) {
+        image->unload();
+        return 1;
+    }
+    auto [error, message] = image->load(path);
+    if (error) {
+        wang_web_error = message.empty() ? error.message() : message;
+        return 0;
+    }
+    return 1;
+}
+
+EMSCRIPTEN_KEEPALIVE void wang_pause(int paused)
+{
+    auto *machine = running_machine::emscripten_get_running_machine();
+    if (!machine) return;
+    if (paused) machine->pause(); else machine->resume();
+    std::fflush(nullptr);
+}
+
+EMSCRIPTEN_KEEPALIVE void wang_flush()
+{
+    auto *machine = running_machine::emscripten_get_running_machine();
+    if (!machine) return;
+    for (const char *tag : { "upd765:0:525dd", "upd765:1:525dd" }) {
+        auto *image = machine->root_device().subdevice<floppy_image_device>(tag);
+        if (!image || !image->exists()) continue;
+        const auto *format = image->get_load_format();
+        if (format && format->supports_save()) image->setup_write(format);
+    }
+    std::fflush(nullptr);
+}
+
+EMSCRIPTEN_KEEPALIVE void wang_reset()
+{
+    auto *machine = running_machine::emscripten_get_running_machine();
+    if (machine) machine->schedule_soft_reset();
+}
+}
+#endif
